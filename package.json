{
  "name": "food-ordering-system",
  "version": "2.0.0",
  "description": "Food Ordering System - Microservices Architecture (Node.js/TypeScript) - Converted from Java/Spring Boot",
  "private": true,
  "workspaces": [
    "common/common-domain",
    "common/common-application",
    "common/common-dataaccess",
    "infrastructure/kafka-producer",
    "infrastructure/kafka-consumer",
    "infrastructure/kafka-model",
    "infrastructure/saga",
    "infrastructure/outbox",
    "customer-service-ts/customer-domain",
    "customer-service-ts/customer-application",
    "customer-service-ts/customer-dataaccess",
    "customer-service-ts/customer-messaging",
    "customer-service-ts/customer-container",
    "payment-service-ts/payment-domain",
    "payment-service-ts/payment-application",
    "payment-service-ts/payment-dataaccess",
    "payment-service-ts/payment-messaging",
    "payment-service-ts/payment-container",
    "restaurant-service-ts/restaurant-domain",
    "restaurant-service-ts/restaurant-application",
    "restaurant-service-ts/restaurant-dataaccess",
    "restaurant-service-ts/restaurant-messaging",
    "restaurant-service-ts/restaurant-container",
    "order-service-ts/order-domain",
    "order-service-ts/order-application-service",
    "order-service-ts/order-dataaccess",
    "order-service-ts/order-messaging",
    "order-service-ts/order-container"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "customer:dev": "npm run dev --workspace=customer-service-ts/customer-container",
    "payment:dev": "npm run dev --workspace=payment-service-ts/payment-container",
    "restaurant:dev": "npm run dev --workspace=restaurant-service-ts/restaurant-container",
    "order:dev": "npm run dev --workspace=order-service-ts/order-container",
    "start:all": "concurrently \"npm run customer:dev\" \"npm run payment:dev\" \"npm run restaurant:dev\" \"npm run order:dev\"",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:restart": "npm run docker:down && npm run docker:up",
    "setup": "npm install && npm run build",
    "dev": "npm run start:all"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "microservices",
    "event-driven",
    "saga",
    "outbox",
    "ddd",
    "clean-architecture",
    "hexagonal-architecture",
    "kafka",
    "typescript",
    "nodejs",
    "food-ordering",
    "order-management"
  ],
  "author": "",
  "license": "MIT"
}
