{
  "name": "food-ordering-system",
  "version": "1.0.0",
  "description": "Microservices-based Food Ordering System with Clean Architecture, DDD, SAGA and Outbox patterns",
  "private": true,
  "workspaces": [
    "common/common-domain",
    "common/common-application",
    "common/common-dataaccess",
    "infrastructure/kafka/kafka-config-data",
    "infrastructure/kafka/kafka-producer",
    "infrastructure/kafka/kafka-consumer",
    "infrastructure/kafka/kafka-model",
    "infrastructure/saga",
    "infrastructure/outbox",
    "customer-service/customer-domain/customer-domain-core",
    "customer-service/customer-domain/customer-application-service",
    "customer-service/customer-dataaccess",
    "customer-service/customer-application",
    "customer-service/customer-messaging",
    "customer-service/customer-container",
    "order-service-ts/order-domain/order-domain-core",
    "order-service-ts/order-domain/order-application-service",
    "order-service-ts/order-dataaccess",
    "order-service-ts/order-application",
    "order-service-ts/order-messaging",
    "order-service-ts/order-container",
    "payment-service-ts/payment-domain-core",
    "payment-service-ts/payment-application-service",
    "payment-service-ts/payment-dataaccess",
    "payment-service-ts/payment-messaging",
    "payment-service-ts/payment-service",
    "restaurant-service/restaurant-domain/restaurant-domain-core",
    "restaurant-service/restaurant-domain/restaurant-application-service",
    "restaurant-service/restaurant-dataaccess",
    "restaurant-service/restaurant-messaging",
    "restaurant-service/restaurant-container"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "customer:dev": "npm run dev --workspace=customer-service/customer-container",
    "order:dev": "npm run dev --workspace=order-service/order-container",
    "payment:dev": "npm run dev --workspace=payment-service/payment-container",
    "restaurant:dev": "npm run dev --workspace=restaurant-service/restaurant-container",
    "start:all": "concurrently \"npm run customer:dev\" \"npm run order:dev\" \"npm run payment:dev\" \"npm run restaurant:dev\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
