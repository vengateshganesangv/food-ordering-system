{
  "name": "food-ordering-system",
  "version": "1.0.0",
  "description": "Food ordering system - Microservices with Clean Architecture, DDD, SAGA, Outbox & Kafka",
  "private": true,
  "workspaces": [
    "common/*",
    "infrastructure/*",
    "infrastructure/kafka/*",
    "order-service",
    "payment-service",
    "restaurant-service",
    "customer-service"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "start:order": "npm run start --workspace=order-service",
    "start:payment": "npm run start --workspace=payment-service",
    "start:restaurant": "npm run start --workspace=restaurant-service",
    "start:customer": "npm run start --workspace=customer-service",
    "dev:order": "npm run dev --workspace=order-service",
    "dev:payment": "npm run dev --workspace=payment-service",
    "dev:restaurant": "npm run dev --workspace=restaurant-service",
    "dev:customer": "npm run dev --workspace=customer-service"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
